<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Rezultat</PackageId>
    <AssemblyName>Rezultat</AssemblyName>
    <RootNamespace>Rezultat</RootNamespace>
    <Description>Result, Maybe, Presence, Validation and Unit outcome carriers with synchronous composition, Maybe/Result and Result/Validation bridges, explicit nullable adaptation, opt-in collection operations and opt-in Result/Maybe query syntax.</Description>
    <PackageTags>result;maybe;option;validation;error-handling</PackageTags>
  </PropertyGroup>

</Project>
