<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The restored package graph of this consumer is inspected evidence: no private development analyzers. -->
    <RezultatDevelopmentAnalyzers>false</RezultatDevelopmentAnalyzers>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Shared/Checks.cs" Link="Checks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rezultat" Version="[$(RezultatPackageVersion)]" />
    <PackageReference Include="Rezultat.Qualification.DiamondInventory" Version="[1.0.0]" />
    <PackageReference Include="Rezultat.Qualification.DiamondOrders" Version="[1.0.0]" />
  </ItemGroup>

</Project>
