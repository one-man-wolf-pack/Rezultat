<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="diamond-libraries" value="../../artifacts/qualification/diamond/feed" />
    <add key="rezultat-issued" value="../../artifacts/qualification/diamond/issued" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="diamond-libraries">
      <package pattern="Rezultat.Qualification.Diamond*" />
    </packageSource>
    <packageSource key="rezultat-issued">
      <package pattern="Rezultat" />
    </packageSource>
  </packageSourceMapping>
</configuration>
