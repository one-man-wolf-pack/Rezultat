<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RezultatConsumerInput>true</RezultatConsumerInput>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(Snippet)" Condition="'$(Snippet)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rezultat" Version="$(RezultatPackageVersion)" />
  </ItemGroup>

</Project>
