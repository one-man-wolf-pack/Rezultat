<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Rezultat.Qualification.AnalyzerLibrary</PackageId>
    <Version>1.0.0</Version>
    <Authors>Rezultat qualification</Authors>
    <Description>Qualification-only library that references the analyzer privately.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rezultat" Version="$(RezultatPackageVersion)" />
    <PackageReference Include="Rezultat.Analyzers" Version="$(RezultatPackageVersion)" PrivateAssets="all" IncludeAssets="analyzers"
                      Condition="'$(WithAnalyzer)' != 'false'" />
  </ItemGroup>

</Project>
