<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- The restored package graph of this consumer is inspected evidence: no private development analyzers. -->
    <RezultatDevelopmentAnalyzers>false</RezultatDevelopmentAnalyzers>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Checks.cs" Link="Checks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rezultat" Version="$(RezultatPackageVersion)" />
  </ItemGroup>

  <!-- Rooted publication analyzes the whole library surface; RezultatRootLibrary=false publishes the ordinary
       consumer with normal reachability. Neither mode replaces the other. -->
  <ItemGroup Condition="'$(RezultatRootLibrary)' != 'false'">
    <TrimmerRootAssembly Include="Rezultat" />
  </ItemGroup>

</Project>
