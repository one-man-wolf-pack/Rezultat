<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Candidate packages are restored only into this isolated cache, which the lanes reset per run. -->
    <RestorePackagesPath>$(ArtifactsPath)/qualification/packages</RestorePackagesPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
